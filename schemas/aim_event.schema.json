{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gamesen:aim-event:0.1.0",
  "title": "Gamesen aim event v0.1 — structural contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "player_id", "session_id", "block_id", "is_synthetic", "source", "scenario", "condition", "timeline_ms", "features", "outcome", "quality"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "player_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "block_id": {"type": ["string", "null"]},
    "is_synthetic": {"type": "boolean"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reference", "sha256", "input_coordinate_space", "extractor_version"],
      "properties": {
        "kind": {"enum": ["controlled_harness", "original_pov", "replay_render", "public_processed", "synthetic"]},
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "input_coordinate_space": {"enum": ["raw_device_counts", "os_cursor_px", "harness_camera_deg", "unknown", "none"]},
        "extractor_version": {"type": "string", "minLength": 1}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "context", "target_motion", "difficulty_cell"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "context": {"enum": ["controlled", "natural"]},
        "target_motion": {"enum": ["static", "moving", "unknown"]},
        "difficulty_cell": {"type": ["string", "null"]}
      }
    },
    "condition": {
      "type": "object", "additionalProperties": false,
      "required": ["assigned_gain_multiplier", "actual_gain_multiplier", "gain_calibrated", "phase"],
      "properties": {
        "assigned_gain_multiplier": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "actual_gain_multiplier": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "gain_calibrated": {"type": "boolean"},
        "phase": {"enum": ["warmup", "discovery", "validation", "observational", "example"]}
      }
    },
    "timeline_ms": {
      "type": "object", "additionalProperties": false,
      "required": ["timebase", "start", "end", "visible", "motor_onset", "first_entry", "click", "fire"],
      "properties": {
        "timebase": {"const": "session_relative_ms"},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0},
        "visible": {"$ref": "#/$defs/nullable_time"},
        "motor_onset": {"$ref": "#/$defs/nullable_time"},
        "first_entry": {"$ref": "#/$defs/nullable_time"},
        "click": {"$ref": "#/$defs/nullable_time"},
        "fire": {"$ref": "#/$defs/nullable_time"}
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_id", "name", "value", "unit", "method", "validity", "missing_reason"],
        "properties": {
          "target_id": {"enum": ["A1", "A2", "A3", "A4", "A5", "A6"]},
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]},
          "unit": {"enum": ["ms", "deg", "target_width", "count", "ratio"]},
          "method": {"type": "string", "minLength": 1},
          "validity": {"enum": ["MEASURED", "PROXY", "UNAVAILABLE", "SYNTHETIC"]},
          "missing_reason": {"type": ["string", "null"], "minLength": 1}
        },
        "allOf": [
          {"if": {"properties": {"validity": {"const": "UNAVAILABLE"}}},
           "then": {"properties": {"value": {"type": "null"}, "missing_reason": {"type": "string", "minLength": 1}}},
           "else": {"properties": {"value": {"type": "number"}, "missing_reason": {"type": "null"}}}}
        ]
      }
    },
    "outcome": {"enum": ["hit", "miss", "no_shot", "timeout", "occluded", "interrupted", "unknown"]},
    "quality": {
      "type": "object", "additionalProperties": false,
      "required": ["alignment_validated", "eligible_for_sensitivity_fit", "reason_codes"],
      "properties": {
        "alignment_validated": {"type": "boolean"},
        "eligible_for_sensitivity_fit": {"type": "boolean"},
        "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"source": {"properties": {"kind": {"const": "synthetic"}}}}},
     "then": {"properties": {"is_synthetic": {"const": true}}}},
    {"if": {"properties": {"is_synthetic": {"const": true}}},
     "then": {"properties": {"quality": {"properties": {"eligible_for_sensitivity_fit": {"const": false}}}}}},
    {"if": {"properties": {"quality": {"properties": {"eligible_for_sensitivity_fit": {"const": true}}}}},
     "then": {"properties": {
       "is_synthetic": {"const": false},
       "quality": {"properties": {"alignment_validated": {"const": true}}},
       "source": {"properties": {"kind": {"enum": ["controlled_harness", "original_pov"]}, "sha256": {"type": "string"}}},
       "condition": {"properties": {"gain_calibrated": {"const": true}, "assigned_gain_multiplier": {"type": "number"}, "actual_gain_multiplier": {"type": "number"}, "phase": {"enum": ["discovery", "validation"]}}}
     }}}
  ],
  "$defs": {
    "nullable_time": {"type": ["number", "null"], "minimum": 0}
  }
}
