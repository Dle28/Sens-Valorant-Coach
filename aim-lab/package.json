{
  "name": "gamesen-aim-lab",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "preview": "node server.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "desktop:smoke": "npm run build && node scripts/desktop.mjs --smoke-test",
    "pack:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.9",
    "three": "0.180.0"
  },
  "main": "desktop/main.cjs",
  "description": "Offline 3D aim practice with VALORANT-style sensitivity and session analysis",
  "author": "Gamesen",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.gamesen.aimlab",
    "productName": "Gamesen Aim Lab",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/main.js",
      "dist/main.js.LEGAL.txt",
      "dist/style.css",
      "desktop/*.cjs",
      "package.json",
      "desktop/app.png",
      "desktop/app.ico"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "desktop/app.ico"
    },
    "portable": {
      "artifactName": "Gamesen-Aim-Lab-${version}-Windows-x64.exe"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "executableName": "gamesen-aim-lab",
      "icon": "desktop/app.png"
    },
    "extraFiles": [
      {
        "from": "desktop/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ]
  }
}
