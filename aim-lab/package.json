{
  "name": "gamesen-aim-lab",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "preview": "node server.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "data:audit": "node scripts/audit-sessions.mjs",
    "lake:sync": "node scripts/sync-data-lake.mjs",
    "ml:build-dataset": "node scripts/build-next-assessment-dataset.mjs",
    "ml:evaluate-baseline": "node scripts/evaluate-next-assessment-baseline.mjs",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "desktop:smoke": "npm run build && node scripts/desktop.mjs --smoke-test",
    "pack:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "pack:linux": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.9",
    "three": "0.180.0"
  },
  "main": "desktop/main.cjs",
  "description": "Offline 3D tactical aim practice with local session analysis and DPI setup guidance",
  "author": "Gamesen",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.gamesen.aimlab",
    "productName": "V-AIM COACH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/index.html",
      "dist/main.js",
      "dist/main.js.LEGAL.txt",
      "dist/style.css",
      "dist/interface.css",
      "dist/assets/fonts/*",
      "dist/assets/models/*.glb",
      "desktop/*.cjs",
      "src/data-contract.js",
      "src/data-lake.js",
      "src/assessment-protocol.js",
      "src/telemetry-features.js",
      "src/aim-geometry.js",
      "package.json",
      "desktop/app.png",
      "desktop/app.ico",
      "dist/assets/maps/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ],
      "signExecutable": false,
      "icon": "desktop/app.ico"
    },
    "portable": {
      "artifactName": "V-AIM-COACH-${version}-Windows-x64.exe"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Game",
      "executableName": "gamesen-aim-lab",
      "icon": "desktop/app.png"
    },
    "extraFiles": [
      {
        "from": "desktop/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ]
  }
}
